<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <!-- Nombre de copies de chaque bloc HDFS -->
    <property>
        <name>dfs.replication</name>
        <value>2</value>
    </property>

    <!-- Répertoire de stockage des métadonnées du NameNode -->
    <property>
        <name>dfs.namenode.name.dir</name>
        <value>file:///hadoop/dfs/name</value>
    </property>

    <!-- Répertoire de stockage des blocs des DataNodes -->
    <property>
        <name>dfs.datanode.data.dir</name>
        <value>file:///hadoop/dfs/data</value>
    </property>

    <!-- Désactiver les permissions HDFS pour ce cluster pédagogique -->
    <property>
        <name>dfs.permissions.enabled</name>
        <value>false</value>
    </property>

</configuration>